meta {
  name: 1. Hospital-Mitarbeiter Token (normaler API-Zugang)
  type: http
  seq: 1
}

post {
  url: {{keycloak_url}}/realms/{{realm}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: password
  client_id: hospital-api
  username: dr.mueller@hospital.de
  password: test123
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("hospital_token", res.body.access_token);
  }
}

tests {
  test("Token erhalten", function() {
    expect(res.status).to.equal(200);
  });

  test("Token enthaelt gekaufte Pakete (administrative + medical-core)", function() {
    const token = res.body.access_token;
    const payload = JSON.parse(atob(token.split('.')[1]));
    const roles = payload.resource_access?.["fhir-server"]?.roles || [];
    expect(roles).to.include("pkg-administrative");
    expect(roles).to.include("pkg-medical-core");
  });

  test("Token enthaelt NICHT pkg-core (nicht gekauft)", function() {
    const token = res.body.access_token;
    const payload = JSON.parse(atob(token.split('.')[1]));
    const roles = payload.resource_access?.["fhir-server"]?.roles || [];
    expect(roles).to.not.include("pkg-core");
  });

  test("Token enthaelt Hospital-Claims (PATNR, FALLNR, VISUM, LOGINNAME)", function() {
    const token = res.body.access_token;
    const payload = JSON.parse(atob(token.split('.')[1]));
    expect(payload.PATNR).to.equal("PAT-001");
    expect(payload.FALLNR).to.equal("FALL-2026-0042");
    expect(payload.VISUM).to.equal("TMU");
    expect(payload.LOGINNAME).to.equal("dr.mueller");
  });
}
