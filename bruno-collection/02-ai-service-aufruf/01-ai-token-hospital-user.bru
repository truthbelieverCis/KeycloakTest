meta {
  name: 1. AI Service Token (Hospital-User via ai-service Client)
  type: http
  seq: 1
}

post {
  url: {{keycloak_url}}/realms/{{realm}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: password
  client_id: ai-service
  client_secret: ai-service-secret
  username: dr.mueller@hospital.de
  password: test123
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("ai_token", res.body.access_token);
  }
}

tests {
  test("Token erhalten", function() {
    expect(res.status).to.equal(200);
  });

  test("Token zeigt azp=ai-service (Client-ID im Token)", function() {
    const token = res.body.access_token;
    const payload = JSON.parse(atob(token.split('.')[1]));
    expect(payload.azp).to.equal("ai-service");
  });

  test("User ist weiterhin dr.mueller (gleicher Hospital-User)", function() {
    const token = res.body.access_token;
    const payload = JSON.parse(atob(token.split('.')[1]));
    expect(payload.preferred_username).to.equal("dr.mueller@hospital.de");
  });

  test("Token hat ALLE Rollen via all-packages Client Scope", function() {
    const token = res.body.access_token;
    const payload = JSON.parse(atob(token.split('.')[1]));
    const roles = payload.resource_access?.["fhir-server"]?.roles || [];
    // all-packages Scope injiziert alle pkg-Rollen ins Token
    expect(roles).to.include("pkg-core");
    expect(roles).to.include("pkg-administrative");
    expect(roles).to.include("pkg-medical-core");
  });
}
