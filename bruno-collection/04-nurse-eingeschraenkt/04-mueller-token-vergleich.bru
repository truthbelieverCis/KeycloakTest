meta {
  name: 4. Dr. Mueller Token (hat beide Pakete)
  type: http
  seq: 4
}

post {
  url: {{keycloak_url}}/realms/{{realm}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: password
  client_id: hospital-api
  username: dr.mueller@hospital.de
  password: test123
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("mueller_token", res.body.access_token);
  }
}

tests {
  test("Token erhalten", function() {
    expect(res.status).to.equal(200);
  });

  test("Dr. Mueller hat beide Pakete (Admin hat ihm beides zugewiesen)", function() {
    const token = res.body.access_token;
    const payload = JSON.parse(atob(token.split('.')[1]));
    const roles = payload.resource_access?.["fhir-server"]?.roles || [];
    expect(roles).to.include("pkg-administrative");
    expect(roles).to.include("pkg-medical-core");
  });
}
