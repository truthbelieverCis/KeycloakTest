meta {
  name: 1. AI Service Token (Client Credentials – kein User)
  type: http
  seq: 1
}

post {
  url: {{keycloak_url}}/realms/{{realm}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: client_credentials
  client_id: ai-service
  client_secret: ai-service-secret
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("ai_cc_token", res.body.access_token);
  }
}

tests {
  test("Token erhalten (Service Account)", function() {
    expect(res.status).to.equal(200);
  });

  test("azp = ai-service (Client Policy greift)", function() {
    const token = res.body.access_token;
    const payload = JSON.parse(atob(token.split('.')[1]));
    expect(payload.azp).to.equal("ai-service");
  });

  test("Kein preferred_username eines Hospital-Users (reiner Service Account)", function() {
    const token = res.body.access_token;
    const payload = JSON.parse(atob(token.split('.')[1]));
    // Service Account hat eigenen Username: service-account-ai-service
    expect(payload.preferred_username).to.equal("service-account-ai-service");
  });

  test("Token hat alle Paket-Rollen via all-packages Scope", function() {
    const token = res.body.access_token;
    const payload = JSON.parse(atob(token.split('.')[1]));
    const roles = payload.resource_access?.["fhir-server"]?.roles || [];
    expect(roles).to.include("pkg-core");
    expect(roles).to.include("pkg-administrative");
    expect(roles).to.include("pkg-medical-core");
  });
}
