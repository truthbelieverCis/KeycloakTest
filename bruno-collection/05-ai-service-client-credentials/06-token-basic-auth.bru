meta {
  name: 6. Token via Basic Auth (Client Credentials)
  type: http
  seq: 6
}

post {
  url: {{keycloak_url}}/realms/{{realm}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: basic
}

auth:basic {
  username: ai-service
  password: ai-service-secret
}

body:form-urlencoded {
  grant_type: client_credentials
  scope: all-packages
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("ai_basic_token", res.body.access_token);
  }
}

tests {
  test("Token erhalten via Basic Auth", function() {
    expect(res.status).to.equal(200);
  });

  test("Identisches Ergebnis wie Body-Auth (azp=ai-service)", function() {
    const token = res.body.access_token;
    const payload = JSON.parse(atob(token.split('.')[1]));
    expect(payload.azp).to.equal("ai-service");
  });

  test("Alle Paket-Rollen vorhanden (all-packages Scope greift auch bei Basic Auth)", function() {
    const token = res.body.access_token;
    const payload = JSON.parse(atob(token.split('.')[1]));
    const roles = payload.resource_access?.["fhir-server"]?.roles || [];
    expect(roles).to.include("pkg-core");
    expect(roles).to.include("pkg-administrative");
    expect(roles).to.include("pkg-medical-core");
  });
}
