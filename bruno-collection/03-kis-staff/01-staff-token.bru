meta {
  name: 1. KIS Staff Token (alle Pakete via Gruppe)
  type: http
  seq: 1
}

post {
  url: {{keycloak_url}}/realms/{{realm}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: password
  client_id: kis-staff-app
  username: dev@kis-hersteller.de
  password: test123
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("staff_token", res.body.access_token);
  }
}

tests {
  test("Token erhalten", function() {
    expect(res.status).to.equal(200);
  });

  test("Staff-Token enthaelt alle Pakete (via staff-Gruppe)", function() {
    const token = res.body.access_token;
    const payload = JSON.parse(atob(token.split('.')[1]));
    const roles = payload.resource_access?.["fhir-server"]?.roles || [];
    expect(roles).to.include("pkg-core");
    expect(roles).to.include("pkg-administrative");
    expect(roles).to.include("pkg-medical-core");
  });
}
